+// ENV-09 (follow-up): /proc/<pid>/comm did not exist at all. Linux tools
+// (ps, pgrep, htop) read it for the 15-char task name; iSH already tracks
+// it as task->comm (set from the executable basename at exec, read under
+// general_lock like proc_pid_stat_show does). Note cmdline is intentionally
+// NOT changed here: it is already correct for every exec'd process, and
+// the one empty case, /proc/1/cmdline, is empty because pid 1 never execs
+// in dsh-go (ISHKernel.m creates it with become_first_process and runs
+// every command as a become_new_init_child + do_execve child), so there
+// is no argv to report — fabricating one would be lying.
+static int proc_pid_comm_show(struct proc_entry *entry, struct proc_data *buf) {
+    struct task *task = proc_get_task(entry);
+    if (task == NULL)
+        return _ESRCH;
+    lock(&task->general_lock);
+    proc_printf(buf, "%s\n", task->comm);
+    unlock(&task->general_lock);
+    proc_put_task(task);
+    return 0;
+}
