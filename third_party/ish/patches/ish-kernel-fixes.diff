+        // Build 22 fixed the OPEN path (sys_openat dups the target fd); stat
+        // with follow was still broken: path_normalize resolves the final
+        // component through procfs's readlink, which returns
+        // "anon_inode:[...]" for pipes, ttys and sockets, and that string is
+        // not a path, so stat -L /proc/self/fd/0 always failed with ENOENT.
+        // Resolve the target fd directly and fstat it instead, before any
+        // path normalization runs. lstat (follow_links == false) is
+        // deliberately NOT intercepted: it must report the link itself.
+        char abs_path[MAX_PATH];
+        if (stat_make_absolute(at, path_raw, abs_path, sizeof(abs_path)) == 0) {
+            int err = 0;
+            struct fd *target = proc_fd_magic_link_target(abs_path, &err);
+            if (target != NULL) {
+                int ferr = target->mount->fs->fstat(target, stat);
+                fd_close(target);
+                return ferr;
+            }
+            if (err < 0)
+                return err;
+        }
+        // Not a magic link (or the path could not be made absolute): fall
+        // through to normal resolution below.
+    }
     char path[MAX_PATH];
     int err = path_normalize(at, path_raw, path, follow_links ? N_SYMLINK_FOLLOW : N_SYMLINK_NOFOLLOW);
     if (err < 0)
diff --git a/kernel/fs.c b/kernel/fs.c
index 554d8220..d6f07289 100644
--- a/kernel/fs.c
+++ b/kernel/fs.c
@@ -66,12 +66,153 @@ dword_t sys_faccessat(fd_t at_f, addr_t path_addr, mode_t_ mode, dword_t flags)
     return err;
 }
 
+// Parse a decimal number from *p; on success *p points past the digits.
+// Returns -1 if there is no digit or the value exceeds the sanity cap.
+static int parse_decimal(const char **p) {
+    const char *s = *p;
+    if (*s < '0' || *s > '9')
+        return -1;
+    long value = 0;
+    while (*s >= '0' && *s <= '9') {
+        value = value * 10 + (*s - '0');
+        if (value > 1000000)
+            return -1;
+        s++;
+    }
+    *p = s;
+    return (int) value;
+}
+
+// Magic links: /proc/<pid>/fd/<n>, /dev/fd/<n>, /dev/std{in,out,err}.
+//
+// Resolves the path to the target fd (retained; the caller owns one
+// reference and must fd_close() it), or NULL. *err is 0 when the path is
+// not a magic link at all, and a negative errno when it IS one but the
+// target task/fd does not exist. Only absolute paths are matched; a
+// relative path, a trailing slash, or extra components do not match.
+// Shared by the open path (try_proc_fd_magic_link, dup semantics) and the
+// stat path (generic_statat, fstat of the target fd): both must agree on
+// what counts as a magic link, or stat -L and open would disagree.
+struct fd *proc_fd_magic_link_target(const char *path, int *err) {
+    int fdnum = -1;
+    int is_self = 0;
+    dword_t pid = 0;
+
+    if (strcmp(path, "/dev/stdin") == 0) { fdnum = 0; is_self = 1; }
+    else if (strcmp(path, "/dev/stdout") == 0) { fdnum = 1; is_self = 1; }
+    else if (strcmp(path, "/dev/stderr") == 0) { fdnum = 2; is_self = 1; }
+    else if (strncmp(path, "/dev/fd/", 8) == 0) {
+        const char *p = path + 8;
+        fdnum = parse_decimal(&p);
+        if (fdnum < 0 || *p != '\0') {
+            *err = 0;
+            return NULL;
+        }
+        is_self = 1;
+    } else if (strncmp(path, "/proc/", 6) == 0) {
+        const char *p = path + 6;
+        if (strncmp(p, "self/", 5) == 0) {
+            p += 5;
+            is_self = 1;
+        } else {
+            int v = parse_decimal(&p);
+            if (v <= 0 || *p != '/') {
+                *err = 0;
+                return NULL;
+            }
+            pid = (dword_t) v;
+            p++; // skip '/'
+        }
+        if (strncmp(p, "fd/", 3) != 0) {
+            *err = 0;
+            return NULL;
+        }
+        p += 3;
+        fdnum = parse_decimal(&p);
+        if (fdnum < 0 || *p != '\0') {
+            *err = 0;
+            return NULL;
+        }
+    } else {
+        *err = 0;
+        return NULL;
+    }
+
+    // Resolve the owning task. "self" is the running task (no lookup, no
+    // race). A numeric pid goes through pid_get_task under pids_lock, with
+    // the same mid-exit rejection proc_get_task uses.
+    struct task *task = NULL;
+    int held_pids_lock = 0;
+    if (is_self) {
+        task = current;
+    } else {
+        lock(&pids_lock);
+        held_pids_lock = 1;
+        task = pid_get_task(pid);
+        if (task != NULL && (task->exiting || task->sighand == NULL || task->group == NULL))
+            task = NULL;
+        if (task == NULL) {
+            unlock(&pids_lock);
+            *err = _ESRCH;
+            return NULL;
+        }
+    }
+
+    // Retain the target fd under the task's files lock (same lock order as
+    // proc_pid_fd_readlink: pids_lock, then files->lock).
+    lock(&task->files->lock);
+    struct fd *fd = fdtable_get(task->files, (fd_t) fdnum);
+    if (fd != NULL)
+        fd = fd_retain(fd);
+    unlock(&task->files->lock);
+    if (held_pids_lock)
+        unlock(&pids_lock);
+    if (fd == NULL) {
+        *err = _ENOENT;
+        return NULL;
+    }
+    *err = 0;
+    return fd;
+}
+
+// Open-path wrapper: dup semantics for a magic link.
+//
+// Returns 1 if path is exactly a proc-fd magic link (result set to the new
+// fd number, or a negative errno when the target does not exist), 0 if not
+// a magic link (the caller does the normal open).
+static int try_proc_fd_magic_link(const char *path, dword_t flags, fd_t *result) {
+    int err = 0;
+    struct fd *fd = proc_fd_magic_link_target(path, &err);
+    if (fd == NULL) {
+        if (err == 0)
+            return 0;
+        *result = err;
+        return 1;
+    }
+    // Dup semantics: the new fd refers to the same open file description.
+    // f_install also honours O_CLOEXEC / O_NONBLOCK from flags, and drops
+    // the retained reference if installation fails.
+    *result = f_install(fd, (int) flags);
+    return 1;
+}
+
 fd_t sys_openat(fd_t at_f, addr_t path_addr, dword_t flags, mode_t_ mode) {
     char path[MAX_PATH];
     if (user_read_string(path_addr, path, sizeof(path)))
         return _EFAULT;
     STRACE("openat(%d, \"%s\", 0x%x, 0x%x)", at_f, path, flags, mode);
 
+    // Magic links: /proc/<pid>/fd/<n> (and /dev/fd/<n>, /dev/std{in,out,err}).
+    // Linux resolves these by duplicating the target fd, NOT by following a
+    // pathname. iSH's procfs readlink returns "anon_inode:[...]" for pipes,
+    // ttys and sockets, and __path_normalize then tries to resolve that
+    // string as a path, which always fails with ENOENT — so open() of
+    // /proc/self/fd/0 on a pipe, process substitution (<(...)), and
+    // /dev/stdin were all broken. Intercept here, before path resolution.
+    fd_t magic_result;
+    if (try_proc_fd_magic_link(path, flags, &magic_result))
+        return magic_result;
+
     if (flags & O_CREAT_)
         apply_umask(&mode);
 
