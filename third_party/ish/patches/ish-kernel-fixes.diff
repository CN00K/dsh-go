+// Build the absolute path of path_raw as seen from dirfd at, for magic-link
+// matching (which only matches absolute paths). Returns 0 on success, -1 if
+// the path cannot be made absolute; the caller then falls through to normal
+// resolution, so a failure here is never fatal.
+static int stat_make_absolute(struct fd *at, const char *path_raw, char *out, size_t out_size) {
+    if (path_raw[0] == '/') {
+        if (strlen(path_raw) >= out_size)
+            return -1;
+        strcpy(out, path_raw);
+        return 0;
+    }
+    // Relative: resolve against the at directory (AT_PWD = caller's cwd),
+    // mirroring path_normalize's base selection. Retain the cwd fd while
+    // the lock is held: a sibling thread sharing fs_info could chdir and
+    // drop the last reference to it between the lookup and the getpath.
+    struct fd *base = at;
+    int retained = 0;
+    if (at == AT_PWD) {
+        lock(&current->fs->lock);
+        base = fd_retain(current->fs->pwd);
+        unlock(&current->fs->lock);
+        retained = 1;
+    }
+    if (base == NULL)
+        return -1;
+    char at_path[MAX_PATH];
+    int err = generic_getpath(base, at_path);
+    if (retained)
+        fd_close(base);
+    if (err < 0)
+        return -1;
+    if (snprintf(out, out_size, "%s%s%s", at_path,
+                 strcmp(at_path, "/") == 0 ? "" : "/", path_raw) >= (int) out_size)
+        return -1;
+    return 0;
+}
+
 int generic_statat(struct fd *at, const char *path_raw, struct statbuf *stat, bool follow_links) {
+    if (follow_links) {
