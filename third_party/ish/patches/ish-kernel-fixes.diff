# ish-kernel-fixes.diff — dsh-go patches to the pinned iSH fork
# (OpenMinis/ish-arm64 @ 0fd17a13, see third_party/ish/source.json).
# Applied by third_party/ish/build-ish.sh after extracting the source
# tarball, before the meson build. The marker in build-ish.sh includes
# this file's SHA256, so any edit forces a fresh extract + re-apply.
#
# P0 (AF_UNIX bind EPERM): fs/sock.c + fs/sock.h — ish_sock_set_tmp_prefix()
#   lets the app point the host-side Unix-socket backing prefix at a
#   writable container dir (NSTemporaryDirectory); the default
#   "/tmp/ishsock" is outside the iOS sandbox. Also hardens the
#   sun_path sprintf to snprintf (ENAMETOOLONG on truncation).
# P1 (proc-fd magic link, open path): kernel/fs.c — sys_openat intercepts
#   /proc/<pid>/fd/<n>, /dev/fd/<n> and /dev/std{in,out,err} and dups the
#   target fd, instead of resolving procfs's "anon_inode:[...]"
#   readlink string as a path (which always ENOENTs for pipes/ttys).
#   The /dev/fd + /dev/std* symlinks themselves are created by the app
#   in ISHKernel.m createDeviceNodes (not in the kernel source).
# ENV-09 (proc-fd magic link, stat path): fs/stat.c + kernel/fs.c +
#   kernel/fs.h — the open-path resolver is factored out as
#   proc_fd_magic_link_target() and reused by generic_statat: stat /
#   fstatat / statx with follow now fstats the target fd directly, so
#   `stat -L /proc/self/fd/0` returns fifo / char device instead of
#   ENOENT (lstat is untouched — it still reports the link itself).
#   Also adds /proc/<pid>/comm (fs/proc/pid.c, from task->comm).
#   /proc/1/cmdline stays empty by design: pid 1 never execs in dsh-go
#   (ISHKernel.m creates it with become_first_process; every command runs
#   as a become_new_init_child + do_execve child), so there is no argv
#   to report and none is fabricated.
# ENV-08 (df hides the root fs): fs/fake.c — fakefs_statfs() reports the
#   host volume backing the rootfs directory (fstatvfs on the mount's
#   root_fd, statvfs on the source path as fallback), checks the return
#   value, and only accepts results with real blocks; if both probes
#   fail it returns the host errno instead of fabricating numbers.
#   Replaces the old reuse of realfs_statfs, which ignored fstatvfs
#   failures and returned all zeros — and df skips zero-block filesystems.
# ENV-05 (ulimit -n 1024): kernel/init.c — init_rlimits RLIMIT_NOFILE
#   {1024, 4096} -> {4096, 8192}. The soft limit is what `ulimit -n`
#   reports and what the fd table enforces (f_install_start /
#   fdtable_expand in fs/fd.c refuse new fds at the soft limit). The host
#   process's own RLIMIT_NOFILE is the outer bound and must be raised by
#   the app at startup (ISHKernel.m, before the kernel starts); without
#   it, guest opens past the host limit fail with EMFILE — graceful,
#   never a crash.
#
# ENV-13 (dsh-go env fix, 2026-11-17): kernel/exec.c + xX_main_Xx.h —
#   the sys_execve force-injection table and the initial-exec table
#   injected PYTHONMALLOC=malloc (mode=1: always replaced, so no
#   user value could override it), PYTHONDONTWRITEBYTECODE=1 (blocked
#   all .pyc caching — ENV-03: pip recompiled ~100 modules from
#   source on every run and routinely exceeded the 60s timeout),
#   GOMAXPROCS=2 and UV_THREADPOOL_SIZE=1 into EVERY guest process.
#   All four are REMOVED here. Go then defaults to runtime.NumCPU
#   and libuv to its default pool; the bridge sets
#   PYTHONDONTWRITEBYTECODE=0 (guestEnv), which also neutralises
#   kernels built before this patch (mode-0: only if absent).
#   KEPT: NO_COLOR=1, PIP_PROGRESS_BAR=off (deliberate — clean tool
#   output), GODEBUG=asyncpreemptoff=1 (correctness: the JIT delivers
#   signals at gadget boundaries, so async preemption is unsafe).
#   KNOWN RISK: the old GOMAXPROCS=2 cap also suppressed TLB
#   stale-pointer crashes from concurrent page-table writes. If Go
#   multi-thread crashes reappear after this lands, re-add a cap —
#   scaled to the CPU count, not 2 — instead of reverting wholesale.
#
# ENV-09 follow-up (readlink /proc/<pid>/fd/N, dsh-go, 2026-11-17):
#   ENV-09 fixed stat and listing; readlink still returned
#   "anon_inode:[unknown]" for every pipe/socket/tty. Root cause was in
#   fs/adhoc.c: adhoc_getpath hardcoded type "unknown" and fd->stat.inode
#   was never filled in for pipes/sockets (Darwin's fstat reports st_ino
#   0 for them, so there is no host number to use). This appends:
#   - fs/adhoc.c: adhoc_alloc_inode() (guest-side inode counter, base
#     2^32) + a type-dispatching adhoc_getpath — pipe:[ino], socket:[ino],
#     anon_inode:[eventfd|timerfd|epoll|inotify|pidfd], /dev/pts/N and
#     /dev/pts/ptmx for pty fds; anon_inode:[unknown] only where no target
#     is derivable (stdio regular file, host-tty stdio).
#   - fs/pipe.c: one inode per pipe, shared by both ends (Linux: one
#     pipe_inode_info). fs/sock.c: one inode per socket (socket(),
#     accept(), each socketpair end, netlink stub). kernel/init.c: piped
#     stdio keeps the host st_ino when nonzero, else allocates one.
#   - fs/tty.c + fs/tty.h: tty_fd_target(), shared by adhoc_getpath and
#     by the new interception in fs/proc/pid.c proc_pid_fd_readlink
#     (/dev/tty and /dev/ptmx fds now resolve to the pty they are).
#   - kernel/epoll.c, kernel/eventfd.c, kernel/time.c, kernel/inotify.c,
#     kernel/pidfd.c: the five anon fd_ops structs (and their forward
#     declarations) lose `static` so adhoc_getpath can identify the
#     subtype; declared in kernel/fs.h.
#   - kernel/calls.c: fast_fstat64 (ARM64 syscall-80 fast path) used the
#     host fstat directly, so fstat on a pipe reported inode 0 while
#     stat -L (ENV-09 hook -> adhoc_fstat) reported the allocated number;
#     it now prefers fd->stat.inode for adhoc fds so all stat routes agree.
#   - Unchanged on purpose: the open-path magic link (build 22), the
#     stat-path interception (ENV-09) and lstat (still the link itself).
#   - NOT fixed: stdio from a regular file (guest never learns its path)
#     and stdio from a host tty fd (no guest /dev/pts/N corresponds) keep
#     anon_inode:[unknown]; the two ends of one HOST pipe can get different
#     numbers (the host exposes no pipe identity — in-guest pipes do share).
#
#
# NOT fixed here (see the 2026-11-16 defect report): signalfd4 /
# memfd_create need real implementations (not stubs); clone3 already
# works (EINVAL for a size-0 args struct is correct Linux behaviour);
# openat2 / epoll_pwait2 / io_uring_setup are deliberate stubs with
# working libc fallbacks; the pty question is app-layer (agent exec
# uses pipes by design; the interactive terminal already has a pty).
diff --git a/fs/fake.c b/fs/fake.c
index ab3f82b7..e6c2d1e0 100644
--- a/fs/fake.c
+++ b/fs/fake.c
@@ -5,6 +5,7 @@
 #include <string.h>
 #include <fcntl.h>
 #include <sys/stat.h>
+#include <sys/statvfs.h>
 #include <sys/file.h>
 #include <sqlite3.h>
 #include <unistd.h>
@@ -1453,11 +1454,64 @@ static void fakefs_inode_orphaned(struct mount *mount, ino_t inode) {
     db_commit(fs);
 }
 
+// ENV-08: statfs for the fake root filesystem.
+//
+// fakefs has no block device of its own — its files live in the host
+// directory the mount's root_fd points at (see fakefs_mount, which opens
+// it via realfs.mount) — so report the host volume backing that directory.
+// This matters because df only lists filesystems with f_blocks > 0
+// (BusyBox df.c: a mount is printed only if f_blocks > 0, unless it was
+// named on the command line or -a was given): the old code reused
+// realfs_statfs, which IGNORED fstatvfs's return value, so a failed
+// fstatvfs silently produced an all-zero result and `df` hid the root
+// filesystem entirely.
+//
+// Two probes, best-effort: fstatvfs on the mount's root_fd first (no path
+// lookup, works even if the source path has since moved), then statvfs on
+// the mount source path as a fallback. A result only counts if it carries
+// real blocks; a zero-block success is treated the same as a failure, so a
+// degenerate host volume cannot hide the row again. If both probes fail,
+// return the host errno instead of fabricating numbers — a visible error
+// beats a df row that lies about free space. The type field is filled in
+// by mount_statfs from the fs magic (0x66616b65, "fake").
+static int fakefs_statfs(struct mount *mount, struct statfsbuf *stat) {
+    struct statvfs vfs = {};
+    int saved_errno = 0;
+    int ok = 0;
+    if (fstatvfs(mount->root_fd, &vfs) == 0 && vfs.f_blocks > 0)
+        ok = 1;
+    else
+        saved_errno = errno;
+    if (!ok) {
+        if (statvfs(mount->source, &vfs) == 0 && vfs.f_blocks > 0)
+            ok = 1;
+        else
+            saved_errno = errno;
+    }
+    if (!ok) {
+        errno = saved_errno != 0 ? saved_errno : EIO;
+        return errno_map();
+    }
+
+    // Defensive clamps: the host numbers should already be consistent, but
+    // a zero block size or an avail/free count above the total would make df
+    // print nonsense (or divide by zero downstream).
+    stat->bsize = vfs.f_bsize != 0 ? (long) vfs.f_bsize : 4096;
+    stat->frsize = vfs.f_frsize != 0 ? (long) vfs.f_frsize : stat->bsize;
+    stat->blocks = vfs.f_blocks;
+    stat->bfree = vfs.f_bfree > vfs.f_blocks ? vfs.f_blocks : vfs.f_bfree;
+    stat->bavail = vfs.f_bavail > stat->bfree ? stat->bfree : vfs.f_bavail;
+    stat->files = vfs.f_files;
+    stat->ffree = vfs.f_ffree > vfs.f_files ? vfs.f_files : vfs.f_ffree;
+    stat->namelen = vfs.f_namemax;
+    return 0;
+}
+
 const struct fs_ops fakefs = {
     .name = "fake", .magic = 0x66616b65,
     .mount = fakefs_mount,
     .umount = fakefs_umount,
-    .statfs = realfs_statfs,
+    .statfs = fakefs_statfs,
     .open = fakefs_open,
     .readlink = fakefs_readlink,
     .link = fakefs_link,
