# references cloned for study (not part of the project)
.refs/
# toolchain logs and screenshots
tooling/*.log
tooling/env.sh
tooling/shots/
# runtime build cache and outputs (large, reproducible via runtime/build-runtime.sh)
runtime/.cache/
runtime/out*/
runtime/.work/
runtime/.build-*.log
# Dart / Flutter tool state
**/.dart_tool/
app/build/
# Gradle writes reports (problems-report.html) here even though Flutter moves the build dir
app/android/build/
# build outputs never belong in git
*.apk
*.aab
# golden-test failure dumps (flutter test writes them next to the goldens)
**/test/**/failures/

# local scratch (agent notes, review packets)
.harness-tmp*/
.claude/
# the media plugin carries its own JS package
runtime/media/dsh-media/node_modules/
# Python bytecode from tooling/
**/__pycache__/
*.pyc
app/test/promo_capture/
site/build/

# Release assets (tooling/release_assets.py)
/dist/

# iOS local-runtime payload archive (large, reproducible from payload/MANIFEST.json)
payload/*.tar.gz

# iSH build products (large, reproducible via third_party/ish/*.sh)
# — never commit the built libs, the rootfs zip, the AOT images or the
# extracted source; the scripts rebuild them from the pinned inputs.
app/ios/IShArtifacts/
third_party/ish-src/
third_party/ish/.cache/
third_party/ish/.work/
# AOT images: recorded .S (hundreds of MB) + the assembled archive.
# The manifest (third_party/ish/aot-manifest.json) IS committed — it is the
# SHA256-pinned pointer to the recorded set, not the images themselves.
third_party/ish/aot/
third_party/ish/*.S
